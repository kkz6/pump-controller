(version 1)
(rule "Separate logic and cabinet ELV domains"
 (constraint clearance (min 2.5mm))
 (condition "(A.NetName == 'HB_DIODE' || A.NetName == 'HB_GATE' || A.NetName == 'HB_IN' || A.NetName == 'HB_LED_A' || A.NetName == 'HB_LED_K' || A.NetName == 'HB_MON' || A.NetName == 'HB_REF' || A.NetName == 'HOST_LOGIC' || A.NetName == 'ISO_0' || A.NetName == 'ISO_5' || A.NetName == 'J31_1' || A.NetName == 'J31_2' || A.NetName == 'LOCAL_LOGIC' || A.NetName == 'PANEL_DIODE' || A.NetName == 'PANEL_GATE' || A.NetName == 'PANEL_IN' || A.NetName == 'PANEL_LED_A' || A.NetName == 'PANEL_LED_K' || A.NetName == 'PANEL_MON' || A.NetName == 'PANEL_REF' || (A.NetName == 'unconnected-(KFB1-*') || (A.NetName == 'unconnected-(D?-*')) != (B.NetName == 'HB_DIODE' || B.NetName == 'HB_GATE' || B.NetName == 'HB_IN' || B.NetName == 'HB_LED_A' || B.NetName == 'HB_LED_K' || B.NetName == 'HB_MON' || B.NetName == 'HB_REF' || B.NetName == 'HOST_LOGIC' || B.NetName == 'ISO_0' || B.NetName == 'ISO_5' || B.NetName == 'J31_1' || B.NetName == 'J31_2' || B.NetName == 'LOCAL_LOGIC' || B.NetName == 'PANEL_DIODE' || B.NetName == 'PANEL_GATE' || B.NetName == 'PANEL_IN' || B.NetName == 'PANEL_LED_A' || B.NetName == 'PANEL_LED_K' || B.NetName == 'PANEL_MON' || B.NetName == 'PANEL_REF' || (B.NetName == 'unconnected-(KFB1-*') || (B.NetName == 'unconnected-(D?-*'))"))
