(version 1)
(rule "Robu SMT to trace" (condition "(A.Type == 'Pad' && B.Type == 'Track') || (B.Type == 'Pad' && A.Type == 'Track')") (constraint clearance (min 0.2mm)))
(rule "Robu via to trace" (condition "(A.Type == 'Via' && B.Type == 'Track') || (B.Type == 'Via' && A.Type == 'Track')") (constraint clearance (min 0.254mm)))
(rule "Robu PTH to trace" (condition "(A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Track') || (B.Type == 'Pad' && B.Pad_Type == 'Through-hole' && A.Type == 'Track')") (constraint clearance (min 0.33mm)))
(rule "Robu PTH pad spacing" (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'") (constraint clearance (min 0.5mm)))

(rule "Lower divider node spacing prototype"
  (condition "(A.hasNetclass('DIV66') && B.hasNetclass('LIVE')) || (B.hasNetclass('DIV66') && A.hasNetclass('LIVE'))")
  (constraint clearance (min 0.6mm)))
(rule "Middle divider node spacing prototype"
  (condition "(A.hasNetclass('DIV132') && B.hasNetclass('LIVE')) || (B.hasNetclass('DIV132') && A.hasNetclass('LIVE'))")
  (constraint clearance (min 1.2mm)))
(rule "Upper divider node spacing prototype"
  (condition "(A.hasNetclass('DIV198') && B.hasNetclass('LIVE')) || (B.hasNetclass('DIV198') && A.hasNetclass('LIVE'))")
  (constraint clearance (min 1.8mm)))
(rule "Hazardous line and coil circuits basic spacing prototype"
  (condition "(A.hasNetclass('HV') && B.hasNetclass('LIVE')) || (B.hasNetclass('HV') && A.hasNetclass('LIVE'))")
  (constraint clearance (min 2mm)))
(rule "Reinforced live to isolated control separation"
  (condition "(A.hasNetclass('LIVE') && B.hasNetclass('SELV')) || (A.hasNetclass('SELV') && B.hasNetclass('LIVE'))")
  (constraint clearance (min 8mm)))
(rule "First divider resistor differential voltage spacing"
  (condition "(A.NetName == 'L_PROTECTED' && B.NetName == 'M_VDIV_0') || (B.NetName == 'L_PROTECTED' && A.NetName == 'M_VDIV_0')")
  (constraint clearance (min 0.6mm)))
(rule "Adjacent divider resistor differential voltage spacing"
  (condition "(A.NetName == 'M_VDIV_0' && B.NetName == 'M_VDIV_1') || (B.NetName == 'M_VDIV_0' && A.NetName == 'M_VDIV_1') || (A.NetName == 'M_VDIV_1' && B.NetName == 'M_VDIV_2') || (B.NetName == 'M_VDIV_1' && A.NetName == 'M_VDIV_2')")
  (constraint clearance (min 0.6mm)))
(rule "Two divider segment differential voltage spacing"
  (condition "(A.NetName == 'M_VDIV_0' && B.NetName == 'M_VDIV_2') || (B.NetName == 'M_VDIV_0' && A.NetName == 'M_VDIV_2')")
  (constraint clearance (min 1.2mm)))
(rule "Field contacts to controller mains and meter"
  (condition "(A.hasNetclass('STARTER_FIELD') && B.hasNetclass('LIVE') && !B.hasNetclass('STARTER_FIELD')) || (B.hasNetclass('STARTER_FIELD') && A.hasNetclass('LIVE') && !A.hasNetclass('STARTER_FIELD'))")
  (constraint clearance (min 8mm)))
(rule "Incoming AC line to neutral"
  (condition "(A.NetName == 'MAINS_L' && B.NetName == 'MAINS_N') || (B.NetName == 'MAINS_L' && A.NetName == 'MAINS_N')")
  (constraint clearance (min 3.2mm)))

(rule "GCT J40 molded locating pegs to four outer solder lands"
  (condition "A.memberOfFootprint('J40') && B.memberOfFootprint('J40') && (((A.Pad_Number == 'A1' || A.Pad_Number == 'A4' || A.Pad_Number == 'A9' || A.Pad_Number == 'A12') && B.Pad_Number == '') || ((B.Pad_Number == 'A1' || B.Pad_Number == 'A4' || B.Pad_Number == 'A9' || B.Pad_Number == 'A12') && A.Pad_Number == ''))")
  (constraint hole_clearance (min 0.254mm)))
(rule "Fused and protected phase to neutral"
  (condition "(A.NetName == 'MAINS_N' && (B.NetName == 'L_FUSED' || B.NetName == 'L_PROTECTED')) || (B.NetName == 'MAINS_N' && (A.NetName == 'L_FUSED' || A.NetName == 'L_PROTECTED'))")
  (constraint clearance (min 3.2mm)))
(rule "U1 fixed AC input land pair only"
  (condition "A.memberOfFootprint('U1') && B.memberOfFootprint('U1') && ((A.Pad_Number == '1' && B.Pad_Number == '2') || (A.Pad_Number == '2' && B.Pad_Number == '1'))")
  (constraint clearance (min 2.8mm)))
